{
  "name": "dsh-team-model-routing",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Subagent model notes: capability and scenario descriptions for the models the official subagent model selection allows, shown to agents that choose a subagent model.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "cordis"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-alpha.3 <0.3.0-0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "build/*.mjs",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "assets/*",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tool-subagent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-util-values": "0.2.2-alpha.3",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.11-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.7-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tool-subagent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tool-testkit": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-util-values": "0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.6-alpha.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "use-sync-external-store": "1.6.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "prepare": "node build/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test build/artifacts.test.mjs build/tooling.test.mjs build/client-style.test.mjs",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run build && npm run typecheck && npm run test && npm run test:unit && npm run test:integration",
    "prepack": "node build/build.mjs"
  }
}
